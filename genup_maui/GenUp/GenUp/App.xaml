<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GenUp"
             x:Class="GenUp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- GenUp Education Modern + Liquid Glass Tokens (Synchronized with Web globals.css) -->
            <Color x:Key="EduBgBase">#ECF7F2</Color>
            <Color x:Key="EduGlassSurface">#CCFFFFFF</Color>
            <Color x:Key="EduGlassFloating">#E0FFFFFF</Color>
            <Color x:Key="EduGlassBorder">#E6FFFFFF</Color>
            <Color x:Key="EduInk">#0F172A</Color>
            <Color x:Key="EduMuted">#475569</Color>
            <Color x:Key="EduEmerald">#059669</Color>
            <Color x:Key="EduEmeraldLight">#D1FAE5</Color>
            <Color x:Key="EduSky">#0284C7</Color>
            <Color x:Key="EduSkyLight">#E0F2FE</Color>
            <Color x:Key="EduAmber">#F59E0B</Color>
            <Color x:Key="EduAmberLight">#FEF3C7</Color>
            <Color x:Key="EduViolet">#7C3AED</Color>
            <Color x:Key="EduVioletLight">#EDE9FE</Color>

            <!-- Liquid Glass Card Style -->
            <Style x:Key="LiquidGlassCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource EduGlassSurface}" />
                <Setter Property="Stroke" Value="{StaticResource EduGlassBorder}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="24" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#1F0F172A" Offset="0,10" Radius="24" Opacity="0.16" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Liquid Glass Floating Bar Style -->
            <Style x:Key="LiquidGlassFloatingBar" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource EduGlassFloating}" />
                <Setter Property="Stroke" Value="#FFFFFFFF" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="22" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#26059669" Offset="0,8" Radius="20" Opacity="0.18" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Gamified Primary CTA Button -->
            <Style x:Key="EduPrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource EduEmerald}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <!-- Liquid Glass Secondary Pill Button -->
            <Style x:Key="EduGlassButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#D9FFFFFF" />
                <Setter Property="TextColor" Value="{StaticResource EduInk}" />
                <Setter Property="BorderColor" Value="#FFFFFFFF" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="14,10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
