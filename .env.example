# 1. Supabase (PostgreSQL + Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# 2. MongoDB Atlas (Lưu tin nhắn Gendio, Hộp thư Phụ huynh, Thông báo & Heartbeat 15 phút)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/genup?retryWrites=true&w=majority
MONGODB_DB_NAME=GenUp

# 3. Firebase Cloud Messaging (Push Notification cho Mobile & Web PWA)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BHk1WTL1maAt9SglsPxueGUqUvfV_Tya39Qag2TKmG-u32zlslhfNbEZokxE2KvKpBVf-javJu5rgh64OrBCzvs

# Firebase Admin SDK (Server-side gửi Push Notification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. Vercel Cron Secret
CRON_SECRET=your-vercel-cron-secret